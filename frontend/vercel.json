{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix ../backend",
  "buildCommand": "npm run build && npm run prisma:generate --prefix ../backend && npm run prisma:migrate:deploy --prefix ../backend && npm run build --prefix ../backend",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "../backend/dist/**",
      "maxDuration": 30
    }
  }
}
